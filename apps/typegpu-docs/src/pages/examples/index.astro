---
import { ExampleLayout } from '../../components/ExampleLayout';
import ExamplePage from '../../components/ExamplePage';
import { ExamplePageSkeleton } from '../../components/ExamplePageSkeleton';
import SiteHeader from '../../components/SiteHeader.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import KitPromo from '../../components/kit/KitPromo.astro';
---

<PageLayout title="Examples | TypeGPU">
  <SiteHeader />
  <ExampleLayout client:load>
    <div class="kit-strip mx-auto box-border w-full max-w-5xl pb-4 md:px-8">
      <KitPromo
        variant="bar"
        dismissKey="examples-strip"
        href="https://docs.swmansion.com/typegpu-kit/examples/"
        linkLabel="See Kit examples"
      >
        <strong>Building something bigger?</strong> TypeGPU Kit gives you cameras,
        lighting, post-processing and more, ready to drop in.
      </KitPromo>
    </div>
    <ExamplePage client:only="react">
      <ExamplePageSkeleton slot="fallback" />
    </ExamplePage>
  </ExampleLayout>
</PageLayout>

<style is:global>
  html,
  body {
    background-color: #f8f9ff;
  }

  :root[data-theme='dark'],
  :root[data-theme='dark'] body {
    background-color: #1b1f2c;
  }

  :root[data-examples-fullscreen] [data-site-header],
  :root[data-examples-fullscreen] .kit-strip,
  .kit-strip:has(> [hidden]) {
    display: none;
  }
</style>
