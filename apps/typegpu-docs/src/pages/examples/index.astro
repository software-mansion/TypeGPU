---
import { ExampleLayout } from '../../components/ExampleLayout';
import ExamplePage from '../../components/ExamplePage';
import { ExamplePageSkeleton } from '../../components/ExamplePageSkeleton';
import SiteHeader from '../../components/SiteHeader.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import KitPromo from '../../components/kit/KitPromo.astro';
---

<PageLayout title="Examples | TypeGPU">
  <SiteHeader />
  <ExampleLayout client:load>
    <div class="kit-strip mx-auto box-border w-full max-w-5xl pb-4 md:px-8">
      <KitPromo
        variant="bar"
        dismissKey="examples-strip"
        href="https://docs.swmansion.com/typegpu-kit/examples/"
        linkLabel="See Kit examples"
      >
        <strong>Building something bigger?</strong> TypeGPU Kit gives you cameras,
        lighting, post-processing and more, ready to drop in.
      </KitPromo>
    </div>
    <script is:inline>
      // An open example takes the strip below its tags, so keep it out of sight up here until it moves
      if (location.hash.startsWith('#example=')) {
        document.currentScript.previousElementSibling.dataset.kitStripWaiting =
          '';
      }
    </script>
    <ExamplePage client:only="react">
      <ExamplePageSkeleton slot="fallback" />
    </ExamplePage>
  </ExampleLayout>
</PageLayout>

<style is:global>
  html,
  body {
    background-color: #f8f9ff;
  }

  :root[data-theme='dark'],
  :root[data-theme='dark'] body {
    background-color: #1b1f2c;
  }

  :root[data-examples-fullscreen] [data-site-header],
  :root[data-examples-fullscreen] .kit-strip,
  .kit-strip:has(> [hidden]),
  .kit-strip[data-kit-strip-waiting],
  [data-kit-strip-slot]:empty,
  [data-kit-strip-slot]:has(.kit-strip > [hidden]) {
    display: none;
  }

  /* Below an open example's tags: as wide as the example, 2rem from the tags and from the code */
  [data-kit-strip-slot] .kit-strip {
    max-width: none;
    margin-top: -1rem;
    padding: 0 0 1rem;
  }
</style>

<script>
  // The strip sits above the showcase. While an example is open, it moves into the slot the example
  // leaves between its tags and its code, and back up here when the example closes.
  const strip = document.querySelector<HTMLElement>('.kit-strip');
  if (strip) {
    const home = document.createComment('kit-strip');
    strip.before(home);

    const place = () => {
      const slot = document.querySelector('[data-kit-strip-slot]');
      if (slot) {
        if (strip.parentElement !== slot) slot.append(strip);
        delete strip.dataset.kitStripWaiting;
      } else {
        if (strip.previousSibling !== home) home.after(strip);
        if (!location.hash.startsWith('#example=')) {
          delete strip.dataset.kitStripWaiting;
        }
      }
    };

    place();
    new MutationObserver(place).observe(document.body, {
      childList: true,
      subtree: true,
    });
  }
</script>
