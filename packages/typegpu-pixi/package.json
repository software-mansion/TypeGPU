{
  "name": "@typegpu/pixi",
  "version": "0.12.0",
  "description": "Utilities for integrating TypeGPU with PixiJS and PixiJS 3D",
  "keywords": [
    "PixiJS",
    "TypeGPU",
    "WebGPU"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion/TypeGPU.git",
    "directory": "packages/typegpu-pixi"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./3d": "./src/3d/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "exports": {
      "./package.json": "./dist/package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "module": "./dist/index.js",
        "import": "./dist/index.js"
      },
      "./3d": {
        "types": "./dist/3d/index.d.ts",
        "module": "./dist/3d/index.js",
        "import": "./dist/3d/index.js"
      }
    },
    "linkDirectory": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:gpu": "vitest run --config vitest.gpu.config.mts",
    "test:types": "pnpm tsc --p ./tsconfig.json --noEmit",
    "prepublishOnly": "tgpu-dev-cli prepack"
  },
  "devDependencies": {
    "@pixi/3d": "catalog:example",
    "@typegpu/gl": "workspace:*",
    "@typegpu/tgpu-dev-cli": "workspace:*",
    "@webgpu/types": "catalog:types",
    "jiti": "catalog:build",
    "pixi.js": "catalog:example",
    "tsdown": "catalog:build",
    "typegpu": "workspace:*",
    "typegpu-testing-utility": "workspace:*",
    "typescript": "catalog:types",
    "unplugin-typegpu": "workspace:*",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@pixi/3d": ">=0.1.0",
    "@typegpu/gl": "workspace:^",
    "pixi.js": ">=8.23.0",
    "typegpu": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pixi/3d": {
      "optional": true
    }
  }
}
